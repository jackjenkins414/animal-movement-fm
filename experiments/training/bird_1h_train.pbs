#!/bin/bash
#
# 1 h rebuild, neural runs (gpuvolta), one model per PBS subjob. Plan: `bird_1h_train.py --list` (630 runs).
#   0-29     Bb     folds 0-9, seeds 0-2)
#   30-59    LSTMBb  (folds 0-9, seeds 0-2)
#   60-149   LSTMS  (30 birds, seeds 0-2)
#   270-389  ablation Bb   (C 24, 48, 72, 96 x folds 0-9 x seeds 0-2)
#   390-509  ablation LSTMBb  (C 24, 48, 72, 96 x folds 0-9 x seeds 0-2)
# XGBoost (150-269, 510-629) runs on the CPU queue; bird_1h_train_cpu.pbs. The driver refuses the wrong queue.
#
# walltime below is a placeholder until the calibration runs set it. Submit in blocks of at most 10:
#   qsub -J 0-9 -v STEPS=20000 experiments/training/bird_1h_train.pbs
#
# calibration (1,000 updates to results/birds_1h_calibration/, no run record), fold 6 at C = 96:
#   qsub -v CALIBRATE=1,INDEX=378 experiments/training/bird_1h_train.pbs
#   qsub -v CALIBRATE=1,INDEX=498 experiments/training/bird_1h_train.pbs
#
# Data side dry run:
#   qsub -v DRY_RUN=1,INDEX=18 -l walltime=00:30:00 experiments/training/bird_1h_train.pbs

#PBS -P um09
#PBS -q gpuvolta
#PBS -l ngpus=1
#PBS -l ncpus=12
#PBS -l mem=48GB
#PBS -l jobfs=10GB
#PBS -l walltime=04:00:00
#PBS -l storage=scratch/um09+gdata/um09
#PBS -l wd
#PBS -N bird_1h_train
#PBS -j oe
#PBS -r y

set -euo pipefail

export PATH="$HOME/.local/bin:$PATH"
export OMP_NUM_THREADS=$PBS_NCPUS
export UV_CACHE_DIR=/g/data/um09/$USER/.cache/uv

cd /g/data/um09/$USER/animal-movement-fm

extra_args=()

if [ "${DRY_RUN:-0}" = "1" ] && [ "${CALIBRATE:-0}" = "1" ]; then
  echo "FAIL: DRY_RUN and CALIBRATE are separate modes; pass one" >&2
  exit 1
fi
if [ "${DRY_RUN:-0}" = "1" ]; then
  extra_args+=(--dry-run)
  STEPS=0
elif [ "${DRY_RUN:-0}" != "0" ]; then
  echo "FAIL: DRY_RUN must be 1 when enabled; got '$DRY_RUN'" >&2
  exit 1
fi
if [ "${CALIBRATE:-0}" = "1" ]; then
  extra_args+=(--calibrate)
  STEPS=0
elif [ "${CALIBRATE:-0}" != "0" ]; then
  echo "FAIL: CALIBRATE must be 1 when enabled; got '$CALIBRATE'" >&2
  exit 1
fi

if [ -n "${INDEX:-}" ]; then
  extra_args+=(--index "$INDEX")
fi

if [ -z "${STEPS:-}" ]; then
  echo "FAIL: pass the registered step budget, e.g. qsub -v STEPS=20000 ..." >&2
  exit 1
fi

echo "=== nci_account before ==="
nci_account -P um09 || true

uv run python experiments/training/bird_1h_train.py \
    --steps "$STEPS" "${extra_args[@]}"

echo "=== nci_account after ==="
nci_account -P um09 || true
