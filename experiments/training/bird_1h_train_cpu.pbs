#!/bin/bash
#
# 1 h rebuild, XGBoost runs (normal, CPU), one model per PBS subjob. Plan: `bird_1h_train.py --list` (630 runs).
#   150-179  XGBBb    (folds 0-9 x horizons 1, 6, 24)
#   180-269 XGBS     (30 birds x horizons 1, 6, 24)
#   510-629  ablation XGBBb  (C 24, 48, 72, 96 x folds 0-9 x horizons)
# Neural runs use the GPU queue: bird_1h_train.pbs. The driver refuses the wrong queue.
#
# walltime and mem from the fold 6, C = 96 calibration (10-10). Submit in blocks of at most 10:
#   qsub -J 150-159 experiments/training/bird_1h_train_cpu.pbs
#
# Calibration (one fit to results/birds_1h_calibration/, no run record), XGBBb fold 6 24 h, C = 96:
#   qsub -v CALIBRATE=1,INDEX=620 experiments/training/bird_1h_train_cpu.pbs
#
# Data side dry run:
#   qsub -v DRY_RUN=1,INDEX=168 -l walltime=00:30:00 experiments/training/bird_1h_train_cpu.pbs

#PBS -P um09
#PBS -q normal
#PBS -l ncpus=16
#PBS -l mem=32GB
#PBS -l jobfs=10GB
#PBS -l walltime=01:00:00
#PBS -l storage=scratch/um09+gdata/um09
#PBS -l wd
#PBS -N bird_1h_train_cpu
#PBS -j oe
#PBS -r y

set -euo pipefail

export PATH="$HOME/.local/bin:$PATH"
export OMP_NUM_THREADS=$PBS_NCPUS
export UV_CACHE_DIR=/g/data/um09/$USER/.cache/uv

cd /g/data/um09/$USER/animal-movement-fm

extra_args=()

if [ "${DRY_RUN:-0}" = "1" ] && [ "${CALIBRATE:-0}" = "1" ]; then
  echo "FAIL: DRY_RUN and CALIBRATE are separate modes; pass one" >&2
  exit 1
fi
if [ "${DRY_RUN:-0}" = "1" ]; then
  extra_args+=(--dry-run)
  STEPS=0
elif [ "${DRY_RUN:-0}" != "0" ]; then
  echo "FAIL: DRY_RUN must be 1 when enabled; got '$DRY_RUN'" >&2
  exit 1
fi
if [ "${CALIBRATE:-0}" = "1" ]; then
  extra_args+=(--calibrate)
  STEPS=0
elif [ "${CALIBRATE:-0}" != "0" ]; then
  echo "FAIL: CALIBRATE must be 1 when enabled; got '$CALIBRATE'" >&2
  exit 1
fi

if [ -n "${INDEX:-}" ]; then
  extra_args+=(--index "$INDEX")
fi

STEPS="${STEPS:-0}"  # XGBoost has no update budget; the driver ignores it
if [ -z "${STEPS:-}" ]; then
  echo "FAIL: pass the registered step budget, e.g. qsub -v STEPS=20000 ..." >&2
  exit 1
fi

echo "=== nci_account before ==="
nci_account -P um09 || true

uv run python experiments/training/bird_1h_train.py \
    --steps "$STEPS" "${extra_args[@]}"

echo "=== nci_account after ==="
nci_account -P um09 || true
