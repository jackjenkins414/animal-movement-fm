#!/bin/bash
# GenAI reference: GenAI cleaned and commented this file only. 
#
# Env study, neural runs (gpuhopper), one model per PBS subjob. Plan: `bird_1h_env_train.py --list` (150 runs).
#   0-29     BbE      (folds 0-9 x seeds 0-2)
#   30-59    LSTMBbE  (folds 0-9 x seeds 0-2)
#   60-89    BbR      (Bb, no env; folds 0-9 x seeds 0-2)
#   90-119   LSTMBbR  (LSTM-Bb, no env; folds 0-9 x seeds 0-2)
# XGBBbE (120-149) runs on the CPU queue: bird_1h_env_train_cpu.pbs. The driver refuses the wrong queue.
#
# walltime and mem below are PROVISIONAL until the fold 6 calibration; pass them on every qsub with -l until they are
# set from it. Calibration (1,000 updates to results/birds_1h_env_calibration/, no run record):
#   qsub -v CALIBRATE=1,INDEX=18 -l walltime=01:00:00,mem=48GB experiments/training/bird_1h_env_train.pbs
#   qsub -v CALIBRATE=1,INDEX=48 -l walltime=01:00:00,mem=48GB experiments/training/bird_1h_env_train.pbs
# After the freeze is committed, in blocks of at most 10:
#   qsub -J 0-9 -v STEPS=20000 -l walltime=<from calibration>,mem=<from calibration> experiments/training/bird_1h_env_train.pbs

#PBS -P um09
#PBS -q gpuhopper
#PBS -l ngpus=1
#PBS -l ncpus=12
#PBS -l mem=48GB
#PBS -l jobfs=10GB
#PBS -l walltime=01:00:00
#PBS -l storage=gdata/um09
#PBS -l wd
#PBS -N bird_1h_env_train
#PBS -j oe
#PBS -r y

set -euo pipefail

export PATH="$HOME/.local/bin:$PATH"
export OMP_NUM_THREADS=$PBS_NCPUS
export UV_CACHE_DIR=/g/data/um09/$USER/.cache/uv

cd /g/data/um09/$USER/animal-movement-fm

extra_args=()

if [ "${DRY_RUN:-0}" != "0" ]; then
  echo "FAIL: the dry run is a CPU job; use bird_1h_env_train_cpu.pbs" >&2
  exit 1
fi
if [ "${CALIBRATE:-0}" = "1" ]; then
  extra_args+=(--calibrate)
  STEPS=0
elif [ "${CALIBRATE:-0}" != "0" ]; then
  echo "FAIL: CALIBRATE must be 1 when enabled; got '$CALIBRATE'" >&2
  exit 1
fi

if [ -n "${INDEX:-}" ]; then
  extra_args+=(--index "$INDEX")
fi

if [ -z "${STEPS:-}" ]; then
  echo "FAIL: pass the registered step budget, e.g. qsub -v STEPS=20000 ..." >&2
  exit 1
fi

echo "=== nci_account before ==="
nci_account -P um09 || true

uv run python experiments/training/bird_1h_env_train.py \
    --steps "$STEPS" "${extra_args[@]}"

echo "=== nci_account after ==="
nci_account -P um09 || true
