#!/bin/bash
# PBS job array over the whole grid (GenAI ref: The PBS part of this I wrote; GenAI added for context for 
# reproducibility). Indices 0-29: 3 cells x 2 archs x 5 seeds at context 24 (this arm is the continuity 
# corrected Tier-1 re-run). Indices 30-39: context ablation at 12, time_season only. Rationale and decision 
# rule live in train_multiseed_gadi.py. Resources below are PER SUBJOB.
#
# Submit:   qsub experiments/training/train_multiseed.pbs
# Monitor:  qstat -u $USER    /    qstat -t <jobid>[]
# Logs:     train_multiseed.o<jobid>.<index>, one per subjob
#
# queued_jobs_threshold is 20 per user, so a 40-element array is refused at submission. Submit in
# chunks, overriding -J from the command line. Do 30-39 first: it gates whether the C=24 arm is the
# final re-run or has to be redone at 12.
#     qsub -J 30-39 experiments/training/train_multiseed.pbs
#     qsub -J 0-9   experiments/training/train_multiseed.pbs
#     qsub -J 10-19 experiments/training/train_multiseed.pbs
#     qsub -J 20-29 experiments/training/train_multiseed.pbs
# max_run is 10 per user / 8 per project, so subjobs trickle through rather than running at once.
#
# gpuhopper is H200 nodes at 48 ncpus / 4 ngpus . Fallback to V100 is just -q gpuvolta; the 12:1 ratio 
# below holds for both, and torch 2.5.1+cu121 ships sm_70 and sm_90 kernels so the same env runs on either. 
# Suspect that pin first on a kernel mismatch. mem: a V100 run peaked at 3.01GB, so 32GB is ~10x headroom.

#PBS -P um09
#PBS -q gpuhopper
#PBS -l ngpus=1
#PBS -l ncpus=12
#PBS -l mem=32GB
#PBS -l jobfs=10GB
#PBS -l walltime=04:00:00
#PBS -l storage=scratch/um09+gdata/um09
#PBS -l wd
#PBS -N train_multiseed
#PBS -j oe
#PBS -J 0-39
# PBS Pro refuses non-rerunnable array jobs and Gadi's site default is -r n. Safe here: each subjob
# only writes its own run_id-keyed outputs, so a requeue overwrites itself and nothing else.
#PBS -r y

export PATH="$HOME/.local/bin:$PATH"
export OMP_NUM_THREADS=$PBS_NCPUS

# uv's default cache (~/.cache/uv) would blow the hard 10 GiB home quota - each subjob resolves a
# ~2 GB CUDA torch wheel, and six subjobs filled it on 28-07-2026. gdata, not scratch: scratch purges
# and same-filesystem-as-venv lets uv hardlink. Also in ~/.bashrc, repeated here for reproducibility.
# Check home with `quota -s`, not `lquota`.
export UV_CACHE_DIR=/g/data/um09/$USER/.cache/uv

cd /g/data/um09/$USER/animal-movement-fm
uv run python experiments/training/train_multiseed_gadi.py
