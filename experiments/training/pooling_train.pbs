#!/bin/bash
#
# Just `tier4_train.pbs` with the same queue, resources and fp32 setup; only the driver, job name, run plan and walltime differ.
#
# Pooling study training, one model per PBS subjob. Run plan: `pooling_train.py --list` (15 runs).
#   0-4     B26bal      (domain-balanced, dense)
#   5-9     B26moe      (A8, MoE)
#   10-14   B26balmoe   (domain-balanced, MoE)
#
# B26 (A8, dense) is carried from Tier 4. All pooling-study runs are exploratory.
#
# Use STEPS=20000. Submit in blocks of at most 10 array jobs.
# Run index 5 alone first if measuring the MoE trunk's cost.
#
# Keep OMP_NUM_THREADS=$PBS_NCPUS to match Tier 4 CPU initialisation.
#
# Optional data-side dry run:
#   qsub -v DRY_RUN=1,INDEX=5 -l walltime=00:20:00 experiments/training/pooling_train.pbs
#   qsub -v DRY_RUN=1 -l walltime=00:30:00 experiments/training/pooling_train.pbs

#PBS -P um09
#PBS -q gpuhopper
#PBS -l ngpus=1
#PBS -l ncpus=12
#PBS -l mem=32GB
#PBS -l jobfs=10GB
#PBS -l walltime=01:30:00
#PBS -l storage=scratch/um09+gdata/um09
#PBS -l wd
#PBS -N pooling_train
#PBS -j oe
#PBS -r y

set -euo pipefail

export PATH="$HOME/.local/bin:$PATH"
export OMP_NUM_THREADS=$PBS_NCPUS
export UV_CACHE_DIR=/g/data/um09/$USER/.cache/uv

cd /g/data/um09/$USER/animal-movement-fm

extra_args=()

# Dry run builds the pool and exits before training.
if [ "${DRY_RUN:-0}" = "1" ]; then
  extra_args+=(--dry-run)
  STEPS=0
elif [ "${DRY_RUN:-0}" != "0" ]; then
  echo "FAIL: DRY_RUN must be 1 when enabled; got '$DRY_RUN'" >&2
  exit 1
fi

# Optional single-run override outside a PBS array.
if [ -n "${INDEX:-}" ]; then
  extra_args+=(--index "$INDEX")
fi

if [ -z "${STEPS:-}" ]; then
  echo "FAIL: pass the registered step budget, e.g. qsub -v STEPS=20000 ..." >&2
  exit 1
fi

echo "=== nci_account before ==="
nci_account -P um09 || true

uv run python experiments/training/pooling_train.py \
    --steps "$STEPS" "${extra_args[@]}"

echo "=== nci_account after ==="
nci_account -P um09 || true