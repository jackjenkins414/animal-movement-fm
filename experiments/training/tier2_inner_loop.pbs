#!/bin/bash
# Tier 2 inner loop: 12 configurations x 3 pseudo-target folds, one seed each.
# Array indices 0-35 are fold major: 0-11 stork, 12-23 Cervus, 24-35 M. leonina.
#
# max array size is 10 so the 36 grid run goes in 4 chunks
#   qsub -v STEPS=<n> -J 0-9   experiments/training/tier2_inner_loop.pbs
#   qsub -v STEPS=<n> -J 10-19 experiments/training/tier2_inner_loop.pbs
#   qsub -v STEPS=<n> -J 20-29 experiments/training/tier2_inner_loop.pbs
#   qsub -v STEPS=<n> -J 30-35 experiments/training/tier2_inner_loop.pbs
#
# Corrected registered probe: grid index 6, seed 0, all three folds (indices 6, 18, 30).
#   qsub -v STEPS=40000,PROBE=1 -J 6-30:12 experiments/training/tier2_inner_loop.pbs
# After all three subjobs finish:
#   uv run python experiments/training/tier2_inner_loop.py --select-probe
#
# Training-only numerical diagnostic; no scoring, no selection. PBS refuses a single-element
# array, so pass the index explicitly and omit -J:
#   qsub -v STEPS=5000,DIAGNOSE=1,PBS_ARRAY_INDEX=18            experiments/training/tier2_inner_loop.pbs
#   qsub -v STEPS=5000,DIAGNOSE=1,NORECON=1,PBS_ARRAY_INDEX=18  experiments/training/tier2_inner_loop.pbs
#
# T3 withholds an optimiser step whose pre-clip gradient norm is non-finite, and applies to every
# run. NOSKIPNF=1 turns it off and ANOMALY=1 turns on autograd anomaly detection; both are
# diagnostic only and are refused outside DIAGNOSE=1.
#   qsub -v STEPS=5000,DIAGNOSE=1,NORECON=1,NOSKIPNF=1,PBS_ARRAY_INDEX=18 experiments/training/tier2_inner_loop.pbs
#   qsub -v STEPS=5000,DIAGNOSE=1,NORECON=1,ANOMALY=1,PBS_ARRAY_INDEX=18  experiments/training/tier2_inner_loop.pbs
#
# Diagnostic only: SDPA={math|efficient} pins the attention backend, while ASINH=1 compresses the displacement 
# channels; together they can distinguish an attention kernel problem from an input representation one...

#PBS -P um09
#PBS -q gpuhopper
#PBS -l ngpus=1
#PBS -l ncpus=12
#PBS -l mem=32GB
#PBS -l jobfs=10GB
#PBS -l walltime=04:00:00
#PBS -l storage=scratch/um09+gdata/um09
#PBS -l wd
#PBS -N tier2_inner
#PBS -j oe
#PBS -r y

set -euo pipefail

export PATH="$HOME/.local/bin:$PATH"
export OMP_NUM_THREADS=$PBS_NCPUS

# keep uvs large CUDA cache off the home quota; prev error
export UV_CACHE_DIR=/g/data/um09/$USER/.cache/uv

cd /g/data/um09/$USER/animal-movement-fm

if [ -z "${STEPS:-}" ]; then
  echo "FAIL: pass the registered step budget, e.g. qsub -v STEPS=40000 ..." >&2
  exit 1
fi

probe_args=()
if [ "${PROBE:-0}" = "1" ]; then
  probe_args=(--probe)
elif [ "${PROBE:-0}" != "0" ]; then
  echo "FAIL: PROBE must be 1 when enabled; got '$PROBE'" >&2
  exit 1
fi

# I added this to the file after GenAI gave it to me; validated that it is correct
if [ "${DIAGNOSE:-0}" = "1" ]; then
  if [ "${PROBE:-0}" = "1" ]; then
    echo "FAIL: DIAGNOSE=1 and PROBE=1 are mutually exclusive" >&2
    exit 1
  fi
  probe_args=(--diagnose)
  if [ "${NORECON:-0}" = "1" ]; then
    probe_args+=(--no-reconstruction)
  elif [ "${NORECON:-0}" != "0" ]; then
    echo "FAIL: NORECON must be 1 when enabled; got '$NORECON'" >&2
    exit 1
  fi
  if [ "${NOSKIPNF:-0}" = "1" ]; then
    probe_args+=(--no-skip-nonfinite)
  elif [ "${NOSKIPNF:-0}" != "0" ]; then
    echo "FAIL: NOSKIPNF must be 1 when enabled; got '$NOSKIPNF'" >&2
    exit 1
  fi
  if [ "${ANOMALY:-0}" = "1" ]; then
    probe_args+=(--anomaly)
  elif [ "${ANOMALY:-0}" != "0" ]; then
    echo "FAIL: ANOMALY must be 1 when enabled; got '$ANOMALY'" >&2
    exit 1
  fi
  if [ -n "${SDPA:-}" ]; then
    probe_args+=(--sdpa "$SDPA")
  fi
  if [ "${ASINH:-0}" = "1" ]; then
    probe_args+=(--asinh-inputs)
  elif [ "${ASINH:-0}" != "0" ]; then
    echo "FAIL: ASINH must be 1 when enabled; got '$ASINH'" >&2
    exit 1
  fi
elif [ "${DIAGNOSE:-0}" != "0" ]; then
  echo "FAIL: DIAGNOSE must be 1 when enabled; got '$DIAGNOSE'" >&2
  exit 1
elif [ "${NORECON:-0}" != "0" ] || [ "${NOSKIPNF:-0}" != "0" ] || [ "${ANOMALY:-0}" != "0" ] \
     || [ -n "${SDPA:-}" ] || [ "${ASINH:-0}" != "0" ]; then
  echo "FAIL: NORECON, NOSKIPNF, ANOMALY, SDPA and ASINH are only meaningful with DIAGNOSE=1" >&2
  exit 1
fi

# GenAI reference: assisted with the PBS run scaffolding, guards and accounting output around my registered 
# Tier 2 experiment and resource specification. And just generally used GenAI to check my work here. 

echo "=== nci_account before ==="
nci_account -P um09 || true

uv run python experiments/training/tier2_inner_loop.py \
    --steps "$STEPS" "${probe_args[@]}"

echo "=== nci_account after ==="
nci_account -P um09 || true
